{
  "id": "pixra.hello-world",
  "name": "Hello World",
  "description": "A simple hello world plugin",
  "contributes": {
    "commands": [
      {
        "command": "helloWorld.sayHello",
        "title": "Hello World"
      }
    ],
    "configuration": {
      "title": "hello-world",
      "properties": {
        "hello-world.greeting": {
          "type": "string",
          "default": "Hello, World!",
          "description": "The greeting message to display"
        }
      }
    }
  }
}