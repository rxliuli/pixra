{
  "name": "@pixra/plugin-sdk",
  "version": "0.0.2",
  "description": "SDK for developing Pixra plugins",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts"
    },
    "./runtime": {
      "default": "./src/runtime.ts"
    }
  },
  "author": "Pixra Team",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "init": "pnpm build",
    "build": "tsdown src/index.ts",
    "dev": "tsdown src/index.ts --watch"
  },
  "keywords": [
    "pixra",
    "plugin",
    "sdk"
  ],
  "devDependencies": {
    "tsdown": "0.20.0-beta.3",
    "typescript": "^5.7.3"
  }
}